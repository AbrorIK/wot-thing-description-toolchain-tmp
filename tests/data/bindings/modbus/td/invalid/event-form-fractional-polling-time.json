{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "modv": "https://www.w3.org/2019/wot/modbus#"
    }
  ],
  "title": "Temperature Sensor",
  "securityDefinitions": {
    "nosec_sc": {
      "scheme": "nosec"
    }
  },
  "security": "nosec_sc",
  "events": {
    "overheating": {
      "forms": [
        {
          "href": "modbus+tcp://192.168.1.50:502/1/100",
          "op": "subscribeevent",
          "modv:entity": "Coil",
          "modv:pollingTime": 2.5
        }
      ]
    }
  }
}
